# ============================================
# FabricXAI Garments Intelligent Platform
# Environment Variables — copy to .env.local
# ============================================

# ============================================
# Supabase Configuration
# ============================================
# Find in: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PROJECT_ID=your_project_id_here

# ============================================
# Application Configuration
# ============================================

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=FabricXAI

# ============================================
# Feature Flags
# ============================================

NEXT_PUBLIC_ENABLE_DEBUG=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ============================================
# Supabase Edge Functions (server-side only — do NOT prefix with NEXT_PUBLIC_)
# ============================================
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
